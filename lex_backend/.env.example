DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# Qwen via Ollama — local LLM (no Anthropic API key needed)
# Install: https://ollama.com  then:  ollama pull qwen2.5:7b-instruct
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_GUARD_MODEL=qwen2.5:7b-instruct
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=120
LLM_GUARD_TIMEOUT=8
LLM_GENERATION_TIMEOUT=60

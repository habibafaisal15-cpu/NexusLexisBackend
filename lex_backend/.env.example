DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# ─── LLM: Google Gemini (recommended for production) ───────────────────────
# Get key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── LLM: Ollama + Qwen (local dev only) ───────────────────────────────────
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:7b-instruct

LLM_MAX_TOKENS=400
LLM_TIMEOUT=120
LLM_GUARD_TIMEOUT=8
LLM_GENERATION_TIMEOUT=60

# ─── Question bank spreadsheet (NOT model training — RAG lookup) ───────────
# Google Sheet → File → Share → Anyone with link → copy sheet ID into URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID/export?format=xlsx
# Sheet tab name must be "Question Bank"
# Column B = questions, Column M = lawyer answers (row 1 = header, data from row 2)
LEX_QUESTION_BANK_URL=https://docs.google.com/spreadsheets/d/1jbWsT2dzag38-F97tnqW9S0YdtZnbiiv/export?format=xlsx

# ─── Auth API (Vercel: nexus-lexis-backend-45v4) — Root Directory: auth_backend ─
DB_HOST=ep-morning-bread-ayihmeh7-pooler.c-5.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password
DB_SSL=true
DB_POOL_MAX=1

JWT_SECRET=your-shared-jwt-secret-same-on-both-apis
JWT_EXPIRES_IN=24h
NODE_ENV=production
CORS_ALLOW_ALL=true

# Where Google sends users after OAuth (must match Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://nexus-lexis-backend-45v4.vercel.app/api/auth/google/callback

# After Google login, users redirect here (/login?token=...)
# Update when your frontend URL is known:
FRONTEND_URL=https://nexuslexis.law
FRONTEND_URLS=https://nexuslexis.law,https://your-frontend.vercel.app

# OTP email (Microsoft Graph)
EMAIL_PROVIDER=graph
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_SENDER=contact@nexuslexis.law
REQUIRE_EMAIL_DELIVERY=true

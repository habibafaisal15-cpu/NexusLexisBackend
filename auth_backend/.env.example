PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexuslexis
DB_USER=postgres
DB_PASSWORD=your_password_here
JWT_SECRET=nexuslexis-dev-secret-key
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_DAYS=30
JWT_EXPIRES_IN=24h
CORS_ALLOW_ALL=true

# Google Sign-In (OAuth 2.0)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Local dev:
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Production (Vercel Auth API — also add in Google Cloud Console):
# GOOGLE_REDIRECT_URI=https://nexus-lexis-backend-45v4.vercel.app/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173

# Demo users on empty DB (dev only). Set SEED_DEMO=false to disable.
# SEED_DEMO=true

# Email — OTP delivery (nexuslexis.law uses Microsoft 365; use Graph, not SMTP)
EMAIL_PROVIDER=graph

# Microsoft Graph (recommended for contact@nexuslexis.law)
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_SENDER=contact@nexuslexis.law

# Production: auth API refuses to start if email is broken
# REQUIRE_EMAIL_DELIVERY=true

# Temporary: skip signup OTP (direct register). Set false when email OTP is live.
# SKIP_SIGNUP_OTP=true
# NODE_ENV=production
# REQUIRE_EMAIL_DELIVERY=true

# Skip MX DNS check in dev if needed
# EMAIL_SKIP_MX_CHECK=true

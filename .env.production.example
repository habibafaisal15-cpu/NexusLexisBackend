# ─── Main API (Vercel: nexus-lexis-backend-ql8w) — repo root ───────────────
DB_HOST=ep-morning-bread-ayihmeh7-pooler.c-5.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password
DB_SSL=true
DB_POOL_MAX=1

JWT_SECRET=your-shared-jwt-secret-same-on-both-apis
NODE_ENV=production
CORS_ALLOW_ALL=true
# When frontend is live, set false and list origins:
# FRONTEND_URLS=https://your-frontend.vercel.app,https://nexuslexis.law

# LEX inline on Vercel (Gemini — no separate Django/Render service)
LEX_MODE=inline
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
LEX_QUESTION_BANK_URL=https://docs.google.com/spreadsheets/d/1I7F5GlelYco_LNzRHRrvjOjDEaJNnNhC/export?format=xlsx
LLM_MAX_TOKENS=500
LLM_GENERATION_TIMEOUT=60

# Do NOT set RUN_STARTUP_DB on Vercel

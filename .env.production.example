# ─── Main API (Vercel project 1 — repo root) ───────────────────────────────
# From Neon console — use the *pooled* host (-pooler) for Vercel serverless
DB_HOST=ep-morning-bread-ayihmeh7-pooler.c-5.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password
DB_SSL=true
DB_POOL_MAX=1

JWT_SECRET=long-random-production-secret-min-32-chars
NODE_ENV=production
CORS_ALLOW_ALL=false
FRONTEND_URLS=https://your-frontend.vercel.app,https://nexuslexis.law

AUTH_API_URL=https://nexuslexis-auth.vercel.app
LEX_API_URL=https://nexuslexis-lex.onrender.com

# Vercel sets VERCEL=1 automatically — DB schema is NOT run on cold start
# Run once locally: DB_HOST=... DB_SSL=true npm run db:migrate

# ─── Auth API (Vercel project 2 — Root Directory: auth_backend) ───────────
# Same DB_* and JWT_SECRET as above
# MS365_TENANT_ID=
# MS365_CLIENT_ID=
# MS365_CLIENT_SECRET=
# MS365_SENDER=contact@nexuslexis.law
# NODE_ENV=production
# REQUIRE_EMAIL_DELIVERY=true
# FRONTEND_URL=https://your-frontend.vercel.app


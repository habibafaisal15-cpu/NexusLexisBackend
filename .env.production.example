# ─── Main API (Vercel project 1 — repo root) ───────────────────────────────
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_NAME=nexuslexis
DB_USER=your_user
DB_PASSWORD=your_password
JWT_SECRET=long-random-production-secret
CORS_ALLOW_ALL=false
FRONTEND_URLS=https://your-frontend.vercel.app,https://nexuslexis.law

# Point to your deployed Auth + LEX services
AUTH_API_URL=https://nexuslexis-auth.vercel.app
LEX_API_URL=https://nexuslexis-lex.onrender.com

# Skip schema on every cold start; run db:migrate once manually
RUN_STARTUP_DB=false

# ─── Auth API (Vercel project 2 — Root Directory: auth_backend) ───────────
# Same DB_* and JWT_SECRET as above
# MS365_TENANT_ID=
# MS365_CLIENT_ID=
# MS365_CLIENT_SECRET=
# MS365_SENDER=contact@nexuslexis.law
# NODE_ENV=production
# REQUIRE_EMAIL_DELIVERY=true
# FRONTEND_URL=https://your-frontend.vercel.app

# ─── LEX AI (Render/Railway — NOT Vercel) ─────────────────────────────────
# LLM_BASE_URL=http://your-ollama-server:11434
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_GENERATION_TIMEOUT=120
# DJANGO_SECRET_KEY=long-random-django-secret
# DJANGO_DEBUG=False
